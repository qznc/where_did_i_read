{
  "manifest_version": 2,
  "name": "Where Did I Read",
  "version": "0.2",

  "browser_specific_settings": {
    "gecko": {
      "id": "{775a3188-27e3-4199-9865-c3b199d58f97}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent"]
      }
    }
  },

  "description": "Indexes all pages you visit and provides a search index",

  "icons": {
    "48": "icons/search.svg"
  },

  "background": {
    "page": "background.html"
  },

  "content_security_policy": "script-src 'self' https://cdnjs.cloudflare.com; object-src 'self'",
  "permissions": ["tabs"],

  "browser_action": {
    "default_title": "Where Did I Read",
    "default_icon": "icons/search.svg"
  },

  "options_ui": {
    "page": "history.html",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-visitor.js"]
    }
  ]
}
