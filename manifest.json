{
  "manifest_version": 2,
  "name": "Search My History",
  "version": "1.0",

  "description": "Indexes all pages you visit and provides a search index",

  "icons": {
    "48": "icons/search.svg"
  },

  "background": {
    "scripts": ["background.js"]
  },

  "permissions": ["storage"],

  "browser_action": {
    "default_title": "Search My History",
    "default_popup": "history.html",
    "default_icon": "icons/search.svg"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-visitor.js"]
    }
  ]
}
