{
  "manifest_version": 2,
  "name": "Where Did I Read",
  "version": "0.1",

  "description": "Indexes all pages you visit and provides a search index",

  "icons": {
    "48": "icons/search.svg"
  },

  "background": {
    "scripts": [
      "vendor/flexsearch.bundle.js",
      "indexing.js",
      "storage.js",
      "background.js"
    ]
  },

  "permissions": ["tabs"],

  "browser_action": {
    "default_title": "Where Did I Read",
    "default_icon": "icons/search.svg"
  },

  "options_ui": {
    "page": "history.html",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-visitor.js"]
    }
  ]
}
