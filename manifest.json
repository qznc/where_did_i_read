{
  "manifest_version": 2,
  "name": "Search My History",
  "version": "1.0",

  "description": "Indexes all pages you visit and provides a search index",

  "icons": {
    "48": "icons/search.svg"
  },

  "background": {
    "scripts": ["indexing.js", "background.js"]
  },

  "permissions": ["storage", "tabs"],

  "browser_action": {
    "default_title": "Search My History",
    "default_icon": "icons/search.svg"
  },

  "options_ui": {
    "page": "history.html",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-visitor.js"]
    }
  ]
}
